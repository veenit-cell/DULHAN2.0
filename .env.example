# Satark.sec Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# JWT Authentication — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ISSUER=satark.neural.core

# HMAC Transaction Signing — must be identical across API server and Celery workers
HMAC_SECRET=

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Redis (Celery broker + velocity cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SQLite
SQLITE_DB=fintech_threat_db.sqlite
